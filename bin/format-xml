#!/bin/bash
# Format XML file in place using xmllint

if [[ $# -eq 0 ]]; then
  echo "Usage: format-xml <file.xml>"
  exit 1
fi

file="$1"

if [[ ! -f "$file" ]]; then
  echo "Error: File '$file' not found"
  exit 1
fi

# Format in place
xmllint --format "$file" --output "$file" && echo "Formatted: $file"
